# MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/maxfitness?retryWrites=true&w=majority

# JWT secret for authentication
JWT_SECRET=your_jwt_secret_here

# Port (optional, defaults to 3000)
PORT=3000

# Gmail SMTP credentials for email notifications
GMAIL_USER=your_gmail_address_here
GMAIL_APP_PASS=your_gmail_app_password_here
